# FlightNoiseTracker — Apache config
#
# Apache strips the per-directory prefix from the URL before matching RewriteRule
# patterns in .htaccess. So if .htaccess lives in /flightnoisetracker/public/
# (the resolved path of the symlink target), a request to /flightnoisetracker/api/health
# arrives here as just `api/health`. Patterns below are RELATIVE to this directory.

# Disable directory listings
Options -Indexes

# Hide dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# CORS + security headers
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>

RewriteEngine On

# /api/* routes → PHP front controller (which strips base_path before routing)
RewriteRule ^api/ index.php [L,QSA]

# /api (no trailing slash) → front controller
RewriteRule ^api$ index.php [L,QSA]

# Static files (assets/, index.html, favicon.ico) — serve directly if they exist
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else (SPA routes like /stats, /flights/99) → React shell
RewriteRule ^ index.html [L,QSA]
