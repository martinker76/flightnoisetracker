{
    "name": "flightnoisetracker/backend",
    "description": "FlightNoiseTracker PHP backend - tracks aircraft movements over Mannersdorf am Leithagebirge",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "phpmailer/phpmailer": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
